{
  "name": "franny-app-be",
  "version": "1.0.0",
  "description": "backend api for franny app",
  "main": "index.js",
  "scripts": {
    "lint": "eslint . --ext .ts",
    "build": "npx tsc",
    "start": "nodemon src/index.ts",
    "prettier": "prettier --config .prettierrc . --ext .ts --write",
    "watch": "tsc-watch --esModuleInterop src/server.ts --outDir ./build --onSuccess \"node ./build/server.js\"",
    "tsc": "tsc",
    "up": "db-migrate up",
    "down": "db-migrate down",
    "test-simple": "npx tsc && jasmine",
    "test": "npx tsc && db-migrate reset --env test && db-migrate --env test up && jasmine"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FrancineMADOH/franny-app.git"
  },
  "keywords": [
    "Feminity",
    "Maternity",
    "Family"
  ],
  "author": "francinemadoh@gmail.com",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/FrancineMADOH/franny-app/issues"
  },
  "homepage": "https://github.com/FrancineMADOH/franny-app#readme",
  "devDependencies": {
    "@types/bcrypt": "^5.0.0",
    "@types/express": "^4.17.15",
    "@types/jasmine": "^4.3.1",
    "@types/jsonwebtoken": "^9.0.1",
    "@types/lodash": "^4.14.191",
    "@types/node": "^18.11.17",
    "@types/node-cache": "^4.2.5",
    "@types/pg": "^7.14.7",
    "@types/sharp": "^0.31.0",
    "@types/supertest": "^2.0.12",
    "@typescript-eslint/eslint-plugin": "^5.51.0",
    "@typescript-eslint/parser": "^5.51.0",
    "eslint": "^8.30.0",
    "eslint-config-prettier": "^8.5.0",
    "eslint-plugin-prettier": "^4.2.1",
    "jasmine": "^3.7.0",
    "jasmine-spec-reporter": "^7.0.0",
    "nodemon": "^2.0.20",
    "prettier": "^2.8.1",
    "supertest": "^6.3.3",
    "ts-node": "^10.9.1",
    "tsc-watch": "^4.2.9",
    "typescript": "^4.9.4"
  },
  "dependencies": {
    "bcrypt": "^5.1.0",
    "body-parser": "^1.19.0",
    "db-migrate": "^0.11.13",
    "db-migrate-pg": "^1.2.2",
    "dotenv": "^16.0.3",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.0",
    "lodash": "^4.17.21",
    "pg": "^8.5.1",
    "sharp": "^0.31.3",
    "typescript": "^4.1.3"
  }
}
